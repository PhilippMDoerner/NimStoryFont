{
  "name": "nimstoryfont-gui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "startNoHMR": "ng serve --no-hmr",
    "build": "NG_BUILD_OPTIMIZE_CHUNKS=1 ng build",
    "build:dev": "NG_BUILD_OPTIMIZE_CHUNKS=1 ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "storybook": "ng run nimstoryfont-gui:storybook",
    "build-storybook": "ng run nimstoryfont-gui:build-storybook",
    "source-map-explorer": "npm run build && source-map-explorer dist/nimstoryfont-gui/*.js",
    "import-visualizer": "npx @rx-angular/import-graph-visualizer --entry-points src/main.ts",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.19",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/platform-browser": "^21.2.19",
    "@angular/platform-browser-dynamic": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@angular/service-worker": "^21.2.19",
    "@bluehalo/ngx-leaflet": "^21.2.1",
    "@ng-bootstrap/ng-bootstrap": "~20.0.0",
    "@ngrx/operators": "^21.1.1",
    "@ngrx/signals": "^21.1.1",
    "@ngx-formly/bootstrap": "^6.3.7",
    "@ngx-formly/core": "^6.3.7",
    "@popperjs/core": "^2.11.6",
    "@tinymce/tinymce-angular": "^7.0.0",
    "bootstrap": "^5.3.3",
    "d3": "^7.9.0",
    "leaflet": "^1.9.3",
    "plyr": "^3.7.8",
    "quill": "^2.0.3",
    "quill-table-up": "^3.5.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.20",
    "@angular/cli": "~21.2.20",
    "@angular/compiler-cli": "^21.2.19",
    "@angular/localize": "^21.2.19",
    "@chromatic-com/storybook": "^5.3.0",
    "@ngrx/schematics": "^21.1.1",
    "@ngx-formly/schematics": "^6.1.3",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-links": "^10.5.7",
    "@storybook/angular": "^10.5.7",
    "@types/d3": "^7.4.3",
    "@types/jasmine": "~4.3.0",
    "@types/leaflet": "^1.9.3",
    "angular-eslint": "20.1.1",
    "eslint": "^9.23.0",
    "eslint-plugin-storybook": "10.5.7",
    "jasmine-core": "~4.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "prettier": "^3.3.3",
    "source-map-explorer": "^2.5.3",
    "storybook": "^10.5.7",
    "storybook-preset-inline-svg": "^1.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
