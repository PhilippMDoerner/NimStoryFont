{
  "name": "@angular/build",
  "version": "22.1.3",
  "description": "Official build system for Angular",
  "keywords": [
    "Angular CLI",
    "Angular DevKit",
    "angular",
    "angular-cli",
    "devkit",
    "sdk"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
